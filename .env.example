# demo = tudo local, sem credenciais. production = exige as integrações abaixo.
NEXT_PUBLIC_APP_MODE=demo

# --- Somente modo produção (não usados pela demonstração) ---
DATABASE_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PAYMENT_PROVIDER_ACCESS_TOKEN=

# Melhor Envio (oficial). Sem estas variáveis o painel permanece em modo demonstração.
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://SEU-DOMINIO/api/melhorenvio/callback
MELHOR_ENVIO_CONTACT_EMAIL=
# Chave longa e aleatória para cifrar os tokens no banco
MELHOR_ENVIO_ENCRYPTION_KEY=
# Código de acesso do administrador às rotas reais da integração
ADMIN_ACCESS_CODE=
# Compra de etiqueta consome saldo da carteira: só use true com decisão explícita
MELHOR_ENVIO_ALLOW_PURCHASE=false

# Recuperação de carrinhos (só produção). Nome do modelo aprovado na Meta para contato fora da janela de 24h.
WHATSAPP_TEMPLATE_RECOVERY=
# Minutos sem atividade para considerar o carrinho abandonado (padrão 60)
CART_IDLE_MINUTES=60
